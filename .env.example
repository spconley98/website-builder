# TEMPLATE — copy to .env and fill in your OWN keys. .env is gitignored, never committed.
# Each collaborator (Sean, Matt) uses their own keys — never share the actual values.

GOOGLE_PLACES_API_KEY=your-google-places-key-here
FIRECRAWL_API_KEY=your-firecrawl-key-here

# Pause Firecrawl-backed prioritization if remaining team credits drop below
