# --- Secrets / local config (NEVER commit) ---
# .mcp.json contains live API keys (Firecrawl etc.) — keep local only
.mcp.json
.env
.env.local
.env.*.local
*.key
# NotebookLM auth state
storage_state.json

# --- Dependencies / build ---
node_modules/
.next/
dist/
dist-ssr
build/
out/

# --- Python ---
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# --- Large generated audio (lives in NotebookLM brain instead — keeps repo lean) ---
*.mp3
*.wav
*.m4a

# --- OS / editor ---
.DS_Store
Thumbs.db
*.log
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Gemini CLI (machine-local skill links + MCP config — absolute paths, not portable) ---
.gemini/

# --- Obsidian (keep reviewed core config; ignore volatile UI state + the plugin execution surface) ---
# .obsidian/ is an executable trust boundary (AGENTS.md §6): a real campaign (REF6598) hid a RAT in
# .obsidian/plugins/<x>/data.json. Never sync community plugins or their data; keep only reviewed core config.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json
.obsidian/plugins/
.obsidian/community-plugins.json
